# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Optional. Defaults to Portfolio <onboarding@resend.dev> for testing.
# For production, use a verified domain: Portfolio <contact@yourdomain.com>
RESEND_FROM=Portfolio <onboarding@resend.dev>

# Public site URL for Open Graph / canonical links (set to your Vercel domain)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
