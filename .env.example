# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Sender shown in the inbox. Quote values that contain < >.
# Sandbox/testing only — verify your domain for production:
RESEND_FROM="Portfolio <onboarding@resend.dev>"

# Where form submissions are delivered. Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
# Resend sandbox (onboarding@resend.dev) only delivers to your Resend account email
# until you verify a domain. Use that email here for testing, or verify your domain.
# RESEND_TO_EMAIL=you@resend-signup-email.com

# Email shown on the site and used in mailto: links
NEXT_PUBLIC_CONTACT_EMAIL=mohanmoganti2023@gmail.com

# Public site URL for Open Graph / canonical links
NEXT_PUBLIC_SITE_URL=https://your-domain.com
